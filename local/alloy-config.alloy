// Grafana Alloy for the LOCAL monitoring stack (docker-compose.yaml).
// Same pipeline as ../alloy-config.alloy (Dennis), but local containers carry
// Compose labels instead of Swarm ones, so the `stack` / `service` labels are
// rebuilt from those — `service` becomes `<project>_<service>` (e.g.
// `magenticx_agents`, `sandbox_sandbox_runner`), exactly as on Dennis — and the
// dashboards' LogQL works unchanged. Keep everything below the relabel block
// identical to the Dennis file.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Ship ONLY the watched Compose projects (magenticx, orthodoxai, sandbox,
  // mcp_gateway) — not the monitoring project's own containers (the regex is
  // anchored), and not any other Compose project running on the laptop.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "magenticx|orthodoxai|sandbox|mcp_gateway"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = "_"
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "stack"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.parse.receiver]
}

// Langfuse project ids, one per app (Langfuse → project Settings → id), from
// the compose environment; used only to build the "Open in Langfuse" links.
loki.process "parse" {
  // JSON lines (every app service with LOG_FORMAT=json): surface `level` as a
  // label so error filtering / alerting is cheap, and keep the correlation ids
  // as STRUCTURED METADATA — high-cardinality, so never labels. Grafana links
  // `trace_id` to Tempo and the langfuse_* paths to Langfuse.
  stage.json {
    expressions = { level = "level", trace_id = "trace_id", thread_id = "thread_id" }
  }

  // Plain-text upstream lines (mcp_gateway's inner dockerd logs logfmt:
  // `level=error msg=...`): same `level` label, upper-cased like the apps'.
  stage.match {
    selector = "{stack=\"mcp_gateway\"}"

    stage.regex {
      expression = "\\blevel=(?P<level>[a-z]+)\\b"
    }
    stage.template {
      source   = "level"
      template = "{{ if .Value }}{{ ToUpper .Value }}{{ end }}"
    }
  }

  // Langfuse deep links. Langfuse URLs carry the project id, and both apps log
  // `"service":"agents"`, so the path is built per stack here, where the stack
  // is known: <projectId>/sessions/<thread_id> and <projectId>/traces/<trace_id>.
  stage.match {
    selector = "{stack=\"magenticx\"}"

    stage.template {
      source   = "langfuse_session"
      template = "{{ if .thread_id }}" + coalesce(sys.env("LANGFUSE_PROJECT_MAGENTICX"), "magenticx") + "/sessions/{{ .thread_id }}{{ end }}"
    }
    stage.template {
      source   = "langfuse_trace"
      template = "{{ if .trace_id }}" + coalesce(sys.env("LANGFUSE_PROJECT_MAGENTICX"), "magenticx") + "/traces/{{ .trace_id }}{{ end }}"
    }
  }
  stage.match {
    selector = "{stack=\"orthodoxai\"}"

    stage.template {
      source   = "langfuse_session"
      template = "{{ if .thread_id }}" + coalesce(sys.env("LANGFUSE_PROJECT_ORTHODOXAI"), "orthodoxai") + "/sessions/{{ .thread_id }}{{ end }}"
    }
    stage.template {
      source   = "langfuse_trace"
      template = "{{ if .trace_id }}" + coalesce(sys.env("LANGFUSE_PROJECT_ORTHODOXAI"), "orthodoxai") + "/traces/{{ .trace_id }}{{ end }}"
    }
  }

  stage.labels {
    values = { level = "" }
  }
  // Empty values are not written, so lines without the ids carry nothing.
  stage.structured_metadata {
    values = { trace_id = "", thread_id = "", langfuse_session = "", langfuse_trace = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
